@{
    ViewData["Title"] = "الاستبيانات";
}

<div class="card card-shadow border-0">
    <div class="card-body">
        <h5 class="mb-3"><i class="fa-solid fa-clipboard-question ms-2"></i>استبيان تجريبي</h5>
        <form>
            <div class="mb-3">
                <label class="form-label">سؤال متعدد الخيارات</label>
                <select class="form-select">
                    <option>خيار 1</option>
                    <option>خيار 2</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">سؤال نصي</label>
                <input class="form-control" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-secondary" type="button">حفظ كمسودة</button>
                <button class="btn btn-accent" type="submit">إرسال</button>
            </div>
        </form>
    </div>
 </div>

