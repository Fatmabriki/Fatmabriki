<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - لوحة تحكم مدائن</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light-rtl">
    <header class="navbar navbar-dark sticky-top flex-md-nowrap p-0 shadow" style="background-color:#4A1A4A;">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" asp-controller="Admin" asp-action="Dashboard">لوحة التحكم</a>
        <div class="navbar-nav">
            <div class="nav-item text-nowrap">
                <a class="nav-link px-3" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-right-from-bracket ms-1"></i>خروج</a>
            </div>
        </div>
    </header>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse border-end" id="sidebarMenu">
                <div class="position-sticky pt-3 sidebar-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-gauge ms-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users"><i class="fa-solid fa-users ms-2"></i>المستخدمون</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Surveys"><i class="fa-solid fa-clipboard-list ms-2"></i>الاستبيانات</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="News"><i class="fa-solid fa-newspaper ms-2"></i>الأخبار</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Reports"><i class="fa-solid fa-chart-line ms-2"></i>التقارير</a></li>
                    </ul>
                </div>
            </nav>
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

