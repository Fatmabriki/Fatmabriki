@model Madayn.Web.Services.ProfileViewModel
@{
    ViewData["Title"] = Localizer["Profile"];
}

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-cover">
            <div class="profile-avatar-container">
                @if (!string.IsNullOrEmpty(Model.Profile.ProfileImageUrl))
                {
                    <img src="@Model.Profile.ProfileImageUrl" alt="@Model.Profile.FullName" class="profile-avatar" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <i class="fas fa-user fa-3x"></i>
                    </div>
                }
                @if (Model.CanEdit)
                {
                    <div class="avatar-edit-overlay">
                        <a href="@Url.Action("Edit")" class="btn btn-sm btn-light">
                            <i class="fas fa-camera"></i> @Localizer["ChangePhoto"]
                        </a>
                    </div>
                }
            </div>
            <div class="profile-info">
                <h2 class="profile-name">@Model.Profile.FullName</h2>
                @if (!string.IsNullOrEmpty(Model.Profile.DisplayName) && Model.Profile.DisplayName != Model.Profile.FullName)
                {
                    <p class="profile-display-name">(@Model.Profile.DisplayName)</p>
                }
                <div class="profile-meta">
                    @if (!string.IsNullOrEmpty(Model.Profile.Position))
                    {
                        <span class="meta-item"><i class="fas fa-briefcase"></i> @Model.Profile.Position</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Profile.Company))
                    {
                        <span class="meta-item"><i class="fas fa-building"></i> @Model.Profile.Company</span>
                    }
                    @if (Model.Profile.RegionId.HasValue && Model.Profile.Region != null)
                    {
                        <span class="meta-item"><i class="fas fa-map-marker-alt"></i> @(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar" ? Model.Profile.Region.RegionNameAr : Model.Profile.Region.RegionNameEn)</span>
                    }
                </div>
                @if (Model.CanEdit)
                {
                    <div class="profile-actions">
                        <a href="@Url.Action("Edit")" class="btn btn-primary"><i class="fas fa-edit"></i> @Localizer["EditProfile"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="profile-content">
        <div class="row">
            <div class="col-lg-8">
                @if (!string.IsNullOrEmpty(Model.Profile.Bio))
                {
                    <div class="profile-section">
                        <h4>@Localizer["About"]</h4>
                        <p class="profile-bio">@Model.Profile.Bio</p>
                    </div>
                }

                <div class="profile-section">
                    <h4>@Localizer["Activity"]</h4>
                    <div class="activity-stats">
                        <div class="stat-item">
                            <span class="stat-number">@Model.ActivityCount.SurveysCompleted</span>
                            <span class="stat-label">@Localizer["SurveysCompleted"]</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">@Model.ActivityCount.CommentsPosted</span>
                            <span class="stat-label">@Localizer["CommentsPosted"]</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">@Model.ActivityCount.RatingsGiven</span>
                            <span class="stat-label">@Localizer["RatingsGiven"]</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                @if (Model.ShowContactInfo)
                {
                    <div class="profile-sidebar-section">
                        <h5>@Localizer["ContactInformation"]</h5>
                        <div class="contact-info">
                            @if (Model.Profile.ShowPhone && !string.IsNullOrEmpty(Model.Profile.Phone))
                            {
                                <div class="contact-item">
                                    <i class="fas fa-phone"></i>
                                    <a href="tel:@Model.Profile.Phone">@Model.Profile.Phone</a>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Profile.Website))
                            {
                                <div class="contact-item">
                                    <i class="fas fa-globe"></i>
                                    <a href="@Model.Profile.Website" target="_blank">@Localizer["Website"]</a>
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (Model.Profile.ShowSocialMedia)
                {
                    <div class="profile-sidebar-section">
                        <h5>@Localizer["SocialMedia"]</h5>
                        <div class="social-links">
                            @if (!string.IsNullOrEmpty(Model.Profile.LinkedIn))
                            {
                                <a href="@Model.Profile.LinkedIn" target="_blank" class="social-link linkedin">
                                    <i class="fab fa-linkedin"></i> LinkedIn
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.Profile.Twitter))
                            {
                                <a href="@Model.Profile.Twitter" target="_blank" class="social-link twitter">
                                    <i class="fab fa-twitter"></i> Twitter
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
