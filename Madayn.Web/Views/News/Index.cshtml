@{
    ViewData["Title"] = Localizer["News"];
    var items = (IEnumerable<dynamic>)ViewBag.Items;
    var regions = (IEnumerable<Madayn.Web.Models.MadaynRegion>)ViewBag.Regions;
    var lang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
}
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@Localizer["News"]</h3>
        <form method="get">
            <select name="regionId" class="form-select" onchange="this.form.submit()">
                <option value="">@Localizer["SelectRegion"]</option>
                @foreach (var r in regions)
                {
                    <option value="@r.RegionId">@(lang=="ar"?r.RegionNameAr:r.RegionNameEn)</option>
                }
            </select>
        </form>
    </div>
    <div class="row g-3">
        @foreach (var n in items)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty((string?)n.ImageUrl)) { <img src="@n.ImageUrl" class="card-img-top" alt="" /> }
                    <div class="card-body">
                        <h5 class="card-title">@n.Title</h5>
                        <p class="card-text">@((n.Content as string)?.Length>120?((string)n.Content).Substring(0,120)+"...":n.Content)</p>
                        <a class="btn btn-primary" href="@Url.Action("Details", new { id=n.NewsId, culture=lang })">@Localizer["Details"]</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
